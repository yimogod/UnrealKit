<Window x:Class="UnrealKit.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:UnrealKit.Desktop.Views"
        Title="UnrealKit" Height="740" Width="1120" MinHeight="520" MinWidth="900">
    <Window.Resources>
        <!--
            导航样式只以 x:Key 显式引用，不使用隐式 TargetType 样式：
            页面内部（例如 MemInfoParseView）也使用 TabControl 展示数据分页，
            隐式样式会顺着资源查找链污染这些内部分页。
        -->
        <Style x:Key="NavigationTabItemStyle" TargetType="TabItem">
            <Setter Property="Padding" Value="13,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#FF1B263B" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="ItemRoot" Background="Transparent" BorderBrush="Transparent" BorderThickness="3,0,0,0">
                            <ContentPresenter ContentSource="Header"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="#FFF1F4F8" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="#FFEDF1F5" />
                                <Setter TargetName="ItemRoot" Property="BorderBrush" Value="#FF1B263B" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavigationTabControlStyle" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Background="White" BorderBrush="#FFE2E6EA" BorderThickness="0,0,1,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="0,12,0,12">
                                        <TextBlock Text="工作流" FontWeight="SemiBold" Foreground="#FF52616B" Margin="16,6,8,10" />
                                        <StackPanel IsItemsHost="True" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <Grid Grid.Column="1" Margin="28">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding SelectedNavigationItem}" FontSize="20" FontWeight="SemiBold" Foreground="#FF1B263B" />
                                <TextBlock Grid.Row="1" Text="{Binding PageDescription}" Foreground="#FF52616B" Margin="0,8,0,0" TextWrapping="Wrap" />
                                <Border Grid.Row="2" Background="White" CornerRadius="6" BorderBrush="#FFE2E6EA" BorderThickness="1" Padding="20">
                                    <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                                </Border>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#FFF7F8FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#FF1B263B" Padding="20,14">
            <DockPanel>
                <TextBlock Text="UnrealKit" Foreground="White" FontSize="22" FontWeight="SemiBold" DockPanel.Dock="Left" />
                <TextBlock Text="{Binding ProjectTitle}" Foreground="#FFD8E0EC" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!--
            Header 即导航标识：SelectedValuePath="Header" 让 SelectedNavigationItem
            继续作为唯一的当前页面来源，标题、说明文本和 ViewModel 判断都读它。
            新增页面时同步 ShellViewModel.PageDescription 的分支。
        -->
        <TabControl Grid.Row="1"
                    Style="{StaticResource NavigationTabControlStyle}"
                    ItemContainerStyle="{StaticResource NavigationTabItemStyle}"
                    SelectedValuePath="Header"
                    SelectedValue="{Binding SelectedNavigationItem, Mode=TwoWay}">
            <TabItem Header="工程"><views:ProjectView /></TabItem>
            <TabItem Header="设备"><views:DevicesView /></TabItem>
            <TabItem Header="启动参数"><views:LaunchParametersView /></TabItem>
            <TabItem Header="采集"><views:CaptureView /></TabItem>
            <TabItem Header="控制台"><views:ConsoleView /></TabItem>
            <TabItem Header="解析"><views:MemInfoParseView /></TabItem>
            <TabItem Header="静态相机"><views:StaticCameraView /></TabItem>
            <TabItem Header="基线差分"><views:BaselineDiffView /></TabItem>
            <TabItem Header="历史趋势"><views:HistoryTrendView /></TabItem>
            <TabItem Header="RenderDoc"><views:RenderDocView /></TabItem>
            <TabItem Header="日志与设置"><views:SettingsView /></TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="White" BorderBrush="#FFE2E6EA" BorderThickness="0,1,0,0" Padding="12,8">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#FF52616B" />
        </Border>
    </Grid>
</Window>
