<Window x:Class="UnrealKit.Desktop.Views.MeshPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:UnrealKit.Desktop.Views"
        Title="模型预览" Height="720" Width="960" MinHeight="400" MinWidth="560"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#FFE2E6EA" BorderThickness="0,0,0,1" Padding="16,10">
            <TextBlock x:Name="TitleText" Text="模型预览"
                       Style="{StaticResource SectionTitleTextStyle}"
                       VerticalAlignment="Center"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- WebView2 预览区 -->
        <views:MeshPreviewControl x:Name="Preview" Grid.Row="1" />
    </Grid>
</Window>
