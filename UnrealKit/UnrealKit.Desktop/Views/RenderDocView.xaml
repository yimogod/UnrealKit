<UserControl x:Class="UnrealKit.Desktop.Views.RenderDocView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="RenderDoc 集成" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="运行 RenderDoc Python 脚本，捕获 GPU 帧分析数据。输出结果保存到指定目录。" Margin="0,10,0,16" TextWrapping="Wrap" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Python 路径" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <DockPanel LastChildFill="True">
                        <Button Content="浏览…" Click="BrowseRenderDocPython_Click" Padding="14,7" Margin="10,0,0,0" DockPanel.Dock="Right" />
                        <TextBox Text="{Binding RenderDocPythonPath, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" VerticalContentAlignment="Center" />
                    </DockPanel>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="脚本路径" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <DockPanel LastChildFill="True">
                        <Button Content="浏览…" Click="BrowseRenderDocScript_Click" Padding="14,7" Margin="10,0,0,0" DockPanel.Dock="Right" />
                        <TextBox Text="{Binding RenderDocScriptPath, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" VerticalContentAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Grid>
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="工作目录 (可选)" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <DockPanel LastChildFill="True">
                        <Button Content="浏览…" Click="BrowseRenderDocWorkingDir_Click" Padding="14,7" Margin="10,0,0,0" DockPanel.Dock="Right" />
                        <TextBox Text="{Binding RenderDocWorkingDir, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" VerticalContentAlignment="Center" />
                    </DockPanel>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="超时 (秒，可选)" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox Text="{Binding RenderDocTimeout, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                </StackPanel>
            </Grid>
            <TextBlock Text="脚本参数 (可选，空格分隔)" FontWeight="SemiBold" Margin="0,12,0,6" />
            <TextBox Text="{Binding RenderDocArguments, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
            <TextBlock Text="输出目录 (可选)" FontWeight="SemiBold" Margin="0,12,0,6" />
            <DockPanel LastChildFill="True">
                <Button Content="浏览…" Click="BrowseRenderDocOutputDir_Click" Padding="14,7" Margin="10,0,0,0" DockPanel.Dock="Right" />
                <TextBox Text="{Binding RenderDocOutputDir, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" VerticalContentAlignment="Center" />
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="执行" Command="{Binding RunRenderDocCommand}" Padding="18,8" />
                <Button Content="打开输出目录" Command="{Binding OpenRenderDocOutputDirCommand}" Padding="18,8" Margin="12,0,0,0" />
            </StackPanel>
        </StackPanel>
        <ScrollViewer Grid.Row="2" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding RenderDocSummary}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                <TabControl MinHeight="350" Margin="0,12,0,0">
                    <TabItem Header="Standard Output">
                        <TextBox Text="{Binding RenderDocStandardOutput, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" />
                    </TabItem>
                    <TabItem Header="Standard Error">
                        <TextBox Text="{Binding RenderDocStandardError, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" Foreground="#FFB02020" />
                    </TabItem>
                    <TabItem Header="Diagnostics">
                        <DataGrid ItemsSource="{Binding RenderDocDiagnostics}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90" />
                                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="90" />
                                <DataGridTextColumn Header="Line" Binding="{Binding Line}" Width="70" />
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
