<UserControl x:Class="UnrealKit.Desktop.Views.DownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- 安装包下载 -->
            <TextBlock Text="安装包下载" Style="{StaticResource StackedFieldLabelTextStyle}" Margin="0,10,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="下载最新" Command="{Binding DownloadCommand}" Padding="18,8" />
                <Button Content="安装到设备" Command="{Binding InstallDownloadedApkCommand}" Padding="18,8" Margin="12,0,0,0" />
                <Button Content="打开下载目录" Command="{Binding OpenDownloadedDirectoryCommand}" Padding="18,8" Margin="12,0,0,0" />
                <Button Content="刷新本地包" Command="{Binding RefreshDownloadedPackagesCommand}" Padding="18,8" Margin="12,0,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding DownloadFolderSummary}" Style="{StaticResource HintTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap" />
            <ListBox ItemsSource="{Binding DownloadedPackages}"
                     SelectedItem="{Binding SelectedDownloadedPackage}"
                     DisplayMemberPath="Display"
                     Height="250" Margin="0,8,0,0" />

            <!-- Pak 包下载 -->
            <TextBlock Text="Pak 包下载" Style="{StaticResource StackedFieldLabelTextStyle}" Margin="0,40,0,0" />
            <TextBlock Text="从 FTP 下载最新 Pak 包（整目录），下载目录与安装包共用 Intermediate/Download/&lt;Platform&gt;。"
                       Style="{StaticResource HintTextStyle}" Margin="0,2,0,0" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="下载最新" Command="{Binding DownloadPakCommand}" Padding="18,8" />
                <Button Content="打开下载目录" Command="{Binding OpenPakDownloadDirectoryCommand}" Padding="18,8" Margin="12,0,0,0" />
                <Button Content="刷新本地包" Command="{Binding RefreshLocalPakPackagesCommand}" Padding="18,8" Margin="12,0,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding PakFolderSummary}" Style="{StaticResource HintTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap" />
            <ListBox ItemsSource="{Binding LocalPakPackages}"
                     SelectedItem="{Binding SelectedLocalPakPackage}"
                     DisplayMemberPath="Display"
                     Height="250" Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
