<UserControl x:Class="UnrealKit.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="项目默认配置" Style="{StaticResource SectionTitleTextStyle}" />
        <TextBlock Text="保存到 Config/DefaultGame.ini。采集和命令行会读取相同项目配置。" Style="{StaticResource HintTextStyle}" Margin="0,12,0,0" />
        <Button Content="保存" Command="{Binding SaveProjectSettingsCommand}" Padding="14,7" HorizontalAlignment="Left" Margin="0,16,0,0" />
        <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 跨平台配置 -->
                <TextBlock Text="UE 项目名" Style="{StaticResource FieldLabelTextStyle}" />
                <TextBox Text="{Binding UnrealProjectName, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                <TextBlock Text="默认 Capture 标签" Style="{StaticResource StackedFieldLabelTextStyle}" />
                <TextBox Text="{Binding CaptureTag, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />

                <!-- 各平台配置并列可编辑：同一工程可以同时跑多个平台，
                     本次操作用哪个平台由设备列表中所选的设备决定，不在此处选择。
                     顶部的平台下拉只过滤列表显示，同样不决定操作平台。 -->
                <TextBlock Text="平台配置" Style="{StaticResource StackedFieldLabelTextStyle}" />
                <TextBlock Text="勾选本工程会用到的平台并填写其配置。采集时的平台由所选设备决定；顶部的平台下拉只用于过滤列表显示。"
                           Style="{StaticResource HintTextStyle}" Margin="0,2,0,8" TextWrapping="Wrap" />

                <GroupBox Margin="0,4,0,0" Padding="10,6,10,10">
                    <GroupBox.Header>
                        <CheckBox Content="Android" FontWeight="SemiBold"
                                  IsChecked="{Binding AndroidEnabled, UpdateSourceTrigger=PropertyChanged}" />
                    </GroupBox.Header>
                    <StackPanel IsEnabled="{Binding AndroidEnabled}">
                        <TextBlock Text="包名" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Text="{Binding PackageName, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                        <TextBlock Text="启动 Activity" Style="{StaticResource StackedFieldLabelTextStyle}" />
                        <TextBox Text="{Binding Activity, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                        <TextBlock Text="设备 UE Game 路径模板" Style="{StaticResource StackedFieldLabelTextStyle}" />
                        <TextBox Text="{Binding DeviceGameRootTemplate, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontFamily="Consolas" />
                        <!-- Saved 目录不单独配置：UE 固定把它放在 Game 目录下，
                             两处分别填写只会让它们对不上。此处只回显派生结果。 -->
                        <TextBlock Text="{Binding DeviceSavedRootPreview, StringFormat='Saved 目录：{0}'}"
                                   Style="{StaticResource HintTextStyle}" Margin="0,4,0,0"
                                   FontFamily="Consolas" TextWrapping="Wrap" />
                        <TextBlock Text="ADB 路径（可选）" Style="{StaticResource StackedFieldLabelTextStyle}" />
                        <TextBox Text="{Binding AdbPath, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                        <TextBlock Text="FTP 父目录（可选）" Style="{StaticResource StackedFieldLabelTextStyle}" />
                        <TextBox Text="{Binding AndroidFtpPath, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontFamily="Consolas" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Margin="0,10,0,0" Padding="10,6,10,10">
                    <GroupBox.Header>
                        <CheckBox Content="Win64" FontWeight="SemiBold"
                                  IsChecked="{Binding Win64Enabled, UpdateSourceTrigger=PropertyChanged}" />
                    </GroupBox.Header>
                    <StackPanel IsEnabled="{Binding Win64Enabled}">
                        <TextBlock Text="可执行文件路径" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Text="{Binding Win64Executable, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                        <TextBlock Text="工作目录" Style="{StaticResource StackedFieldLabelTextStyle}" />
                        <TextBox Text="{Binding Win64WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                        <TextBlock Text="FTP 父目录（可选）" Style="{StaticResource StackedFieldLabelTextStyle}" />
                        <TextBox Text="{Binding Win64FtpPath, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontFamily="Consolas" />
                    </StackPanel>
                </GroupBox>

                <!-- FTP 下载：主机 / 端口 / 凭据跨平台共享，父目录在各平台分组里配置。 -->
                <TextBlock Text="FTP 下载" Style="{StaticResource StackedFieldLabelTextStyle}" />
                <TextBlock Text="主机与凭据供 Android / Win64 共用；各平台的父目录在上方对应分组中填写。密码为敏感信息，仅在此掩码显示，不写入日志。"
                           Style="{StaticResource HintTextStyle}" Margin="0,2,0,8" TextWrapping="Wrap" />
                <GroupBox Margin="0,4,0,0" Padding="10,6,10,10">
                    <StackPanel>
                        <TextBlock Text="主机" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Text="{Binding FtpHost, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                        <TextBlock Text="端口" Style="{StaticResource StackedFieldLabelTextStyle}" />
                        <TextBox Text="{Binding FtpPort, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                        <TextBlock Text="用户名" Style="{StaticResource StackedFieldLabelTextStyle}" />
                        <TextBox Text="{Binding FtpUsername, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                        <TextBlock Text="密码" Style="{StaticResource StackedFieldLabelTextStyle}" />
                        <PasswordBox x:Name="FtpPasswordBox"
                                     PasswordChanged="FtpPasswordBox_PasswordChanged"
                                     DataContextChanged="FtpPasswordBox_DataContextChanged"
                                     Padding="8,6" />
                    </StackPanel>
                </GroupBox>


            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
