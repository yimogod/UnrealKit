<UserControl x:Class="UnrealKit.Desktop.Views.StaticCameraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedNavigationItem}" Value="静态相机">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="静态相机性能解析" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="选择包含 !!!Do Perf Start!!! / !!!Do Perf End!!! 标记的日志文件，可选指定截图目录进行关联。" Margin="0,10,0,16" TextWrapping="Wrap" />
            <TextBlock Text="日志文件" FontWeight="SemiBold" Margin="0,0,0,6" />
            <DockPanel LastChildFill="True">
                <Button Content="浏览…" Click="BrowseScpLog_Click" Padding="14,7" Margin="10,0,0,0" DockPanel.Dock="Right" />
                <TextBox Text="{Binding ScpLogPath, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" VerticalContentAlignment="Center" />
            </DockPanel>
            <TextBlock Text="截图目录 (可选)" FontWeight="SemiBold" Margin="0,12,0,6" />
            <DockPanel LastChildFill="True">
                <Button Content="浏览…" Click="BrowseScpScreenshots_Click" Padding="14,7" Margin="10,0,0,0" DockPanel.Dock="Right" />
                <TextBox Text="{Binding ScpScreenshotsDir, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" VerticalContentAlignment="Center" />
            </DockPanel>
            <Button Content="解析" Command="{Binding ParseStaticCameraCommand}" HorizontalAlignment="Left" Padding="18,8" Margin="0,16,0,0" />
        </StackPanel>
        <ScrollViewer Grid.Row="2" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding ScpParseDescription}" FontWeight="SemiBold" FontSize="16" />
                <TabControl MinHeight="350" Margin="0,12,0,0">
                    <TabItem Header="Frames">
                        <DataGrid ItemsSource="{Binding ScpFrames}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40" />
                                <DataGridTextColumn Header="Camera" Binding="{Binding CameraName}" Width="120" />
                                <DataGridTextColumn Header="Frame ms" Binding="{Binding FrameTimeMs}" Width="80" />
                                <DataGridTextColumn Header="Game ms" Binding="{Binding GameTimeMs}" Width="80" />
                                <DataGridTextColumn Header="Draw ms" Binding="{Binding DrawTimeMs}" Width="80" />
                                <DataGridTextColumn Header="RHI ms" Binding="{Binding RhiTimeMs}" Width="80" />
                                <DataGridTextColumn Header="GPU ms" Binding="{Binding GpuTimeMs}" Width="80" />
                                <DataGridTextColumn Header="Memory" Binding="{Binding MemoryBytes}" Width="90" />
                                <DataGridTextColumn Header="DrawCalls" Binding="{Binding DrawCalls}" Width="80" />
                                <DataGridTextColumn Header="Triangles" Binding="{Binding Triangles}" Width="80" />
                                <DataGridTextColumn Header="Screenshots" Binding="{Binding Screenshots}" Width="80" />
                                <DataGridTextColumn Header="Line" Binding="{Binding Line}" Width="60" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Averages">
                        <DataGrid ItemsSource="{Binding ScpAverages}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Frame ms" Binding="{Binding FrameTimeMs}" Width="100" />
                                <DataGridTextColumn Header="Game ms" Binding="{Binding GameTimeMs}" Width="100" />
                                <DataGridTextColumn Header="Draw ms" Binding="{Binding DrawTimeMs}" Width="100" />
                                <DataGridTextColumn Header="RHI ms" Binding="{Binding RhiTimeMs}" Width="100" />
                                <DataGridTextColumn Header="GPU ms" Binding="{Binding GpuTimeMs}" Width="100" />
                                <DataGridTextColumn Header="Memory" Binding="{Binding MemoryBytes}" Width="100" />
                                <DataGridTextColumn Header="DrawCalls" Binding="{Binding DrawCalls}" Width="100" />
                                <DataGridTextColumn Header="Triangles" Binding="{Binding Triangles}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Diagnostics">
                        <DataGrid ItemsSource="{Binding ScpDiagnostics}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90" />
                                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="90" />
                                <DataGridTextColumn Header="Line" Binding="{Binding Line}" Width="70" />
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
