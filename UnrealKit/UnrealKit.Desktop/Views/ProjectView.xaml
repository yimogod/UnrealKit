<UserControl x:Class="UnrealKit.Desktop.Views.ProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedNavigationItem}" Value="工程">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <StackPanel Margin="0,0,0,28">
        <TextBlock Text="创建工程" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="创建工程只会生成必要的 .ukit、默认配置和空目录；目标目录非空时会拒绝覆盖。" Margin="0,10,0,16" TextWrapping="Wrap" />
        <TextBlock Text="工程名称" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBox Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
        <TextBlock Text="工程目录" FontWeight="SemiBold" Margin="0,12,0,6" />
        <DockPanel LastChildFill="True">
            <Button Content="浏览…" Click="BrowseNewProjectDirectory_Click" Padding="14,7" Margin="10,0,0,0" DockPanel.Dock="Right" />
            <TextBox Text="{Binding NewProjectDirectory, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Padding="8,6" />
        </DockPanel>
        <Button Content="创建工程" Command="{Binding CreateProjectCommand}" HorizontalAlignment="Left" Padding="18,8" Margin="0,16,0,0" />

        <TextBlock Text="打开工程" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,0" />
        <TextBlock Text="选择现有 .ukit 工程描述符。打开时会校验格式版本、目录和默认配置。" Margin="0,10,0,16" TextWrapping="Wrap" />
        <TextBlock Text="工程文件" FontWeight="SemiBold" Margin="0,0,0,6" />
        <DockPanel LastChildFill="True">
            <Button Content="浏览…" Click="BrowseProjectFile_Click" Padding="14,7" Margin="10,0,0,0" DockPanel.Dock="Right" />
            <TextBox Text="{Binding ProjectFilePath, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Padding="8,6" />
        </DockPanel>
        <Button Content="打开工程" Command="{Binding OpenProjectCommand}" HorizontalAlignment="Left" Padding="18,8" Margin="0,16,0,0" />
    </StackPanel>
</UserControl>
