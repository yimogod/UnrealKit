<UserControl x:Class="UnrealKit.Desktop.Views.CaptureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="采集归档" Style="{StaticResource SectionTitleTextStyle}" />
        <StackPanel Grid.Row="1" Margin="0,14,0,0">
            <TextBlock Text="Capture 标签" Style="{StaticResource FieldLabelTextStyle}" />
            <TextBox Text="{Binding CaptureTag, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
            <TextBlock Text="执行会采集 dumpsys meminfo 并拉取 UE Saved；原始文件只会写入新的 Content Capture。" Style="{StaticResource HintTextStyle}" Margin="0,10,0,0" />
        </StackPanel>
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox Text="{Binding CaptureArchivePreview, Mode=OneWay}" IsReadOnly="True" Padding="8" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Content="采集并归档" Command="{Binding RunCaptureCommand}" Padding="14,7" />
                    <!-- 与「采集并归档」并列但语义不同：这个按钮只把设备 Saved 取到本地供翻看，
                         不写 Content 归档、不生成清单，因此提示文字必须说清落地位置。 -->
                    <Button Content="下载 Saved" Command="{Binding DownloadDeviceSavedCommand}" Padding="14,7" Margin="12,0,0,0"
                            ToolTip="把所选设备上的 UE Saved 整目录取回本地并打开该目录。不写入 Content 归档。" />
                    <!-- 单独给 Logs 一个入口：排查问题时通常只看日志，
                         而完整 Saved 可能很大（含 Profiling、截图）。 -->
                    <Button Content="下载 Log" Command="{Binding DownloadDeviceLogsCommand}" Padding="14,7" Margin="12,0,0,0"
                            ToolTip="只把所选设备上的 UE Saved/Logs 目录取回本地并打开该目录。不写入 Content 归档。" />
                </StackPanel>
                <TextBlock Text="「下载 Saved」与「下载 Log」分别取回设备的 Saved 整目录和其中的 Logs 子目录，落地在工程 Saved/DeviceSaved/&lt;平台&gt;/&lt;时间戳-设备-范围&gt;/ 下，每次进新目录，不覆盖上一次；这是可再生的派生数据，不是采集归档。"
                           Style="{StaticResource HintTextStyle}" Margin="0,10,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding DeviceSavedDownloadSummary}" Style="{StaticResource HintTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap" FontFamily="Consolas" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
