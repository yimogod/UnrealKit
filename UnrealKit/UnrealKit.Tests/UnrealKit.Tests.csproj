<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UnrealKit.Core\UnrealKit.Core.csproj" />
    <ProjectReference Include="..\UnrealKit.Desktop\UnrealKit.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="TestData\MemInfo\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="TestData\MemReport\*.memreport" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Update="TestData\StaticCamera\*.log" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Update="TestData\Baseline\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="TestData\Baseline\*.memreport" CopyToOutputDirectory="PreserveNewest" />
    <None Update="TestData\Baseline\*.log" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
