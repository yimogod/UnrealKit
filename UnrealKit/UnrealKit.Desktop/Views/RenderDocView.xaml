<UserControl x:Class="UnrealKit.Desktop.Views.RenderDocView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="RenderDoc 集成" Style="{StaticResource SectionTitleTextStyle}" />
            <TextBlock Text="运行 RenderDoc Python 脚本，捕获 GPU 帧分析数据。脚本路径、工作目录与输出目录在「Project → Setting」中配置。" Style="{StaticResource SectionDescriptionTextStyle}" />
            <TextBlock Text="脚本参数 (可选，空格分隔)" Style="{StaticResource FieldLabelTextStyle}" />
            <TextBox Text="{Binding RenderDocArguments, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="执行" Command="{Binding RunRenderDocCommand}" Padding="18,8" />
                <Button Content="打开输出目录" Command="{Binding OpenRenderDocOutputDirCommand}" Padding="18,8" Margin="12,0,0,0" />
            </StackPanel>
        </StackPanel>
        <ScrollViewer Grid.Row="2" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding RenderDocSummary}" Style="{StaticResource ResultSummaryTextStyle}" />
                <TabControl MinHeight="350" Margin="0,12,0,0">
                    <TabItem Header="Standard Output">
                        <TextBox Text="{Binding RenderDocStandardOutput, Mode=OneWay}" Style="{StaticResource MonospaceOutputTextBoxStyle}" />
                    </TabItem>
                    <TabItem Header="Standard Error">
                        <TextBox Text="{Binding RenderDocStandardError, Mode=OneWay}" Style="{StaticResource MonospaceOutputTextBoxStyle}" Foreground="#FFB02020" />
                    </TabItem>
                    <TabItem Header="Diagnostics">
                        <DataGrid ItemsSource="{Binding RenderDocDiagnostics}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90" />
                                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="90" />
                                <DataGridTextColumn Header="Line" Binding="{Binding Line}" Width="70" />
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
