<Window x:Class="UnrealKit.Desktop.Views.TexturePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="纹理预览" Height="640" Width="800" MinHeight="360" MinWidth="480"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#FFE2E6EA" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <TextBlock x:Name="TitleText" Text="纹理预览"
                           Style="{StaticResource SectionTitleTextStyle}"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           MaxWidth="560" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="导出 PNG…" x:Name="ExportButton" Click="ExportButton_Click"
                            Padding="14,7" Margin="0,0,8,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 主区域：图片 + 元数据 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" MinWidth="160" MaxWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- 图片区域 -->
            <Border Grid.Column="0" Background="#FF1E1E1E" Margin="0">
                <Grid>
                    <!-- 棋盘格背景（透明通道可视化） -->
                    <Rectangle x:Name="CheckerBoard">
                        <Rectangle.Fill>
                            <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <DrawingGroup>
                                        <GeometryDrawing Brush="#FF888888">
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="0,0,16,16" />
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                        <GeometryDrawing Brush="#FFAAAAAA">
                                            <GeometryDrawing.Geometry>
                                                <GeometryGroup>
                                                    <RectangleGeometry Rect="0,0,8,8" />
                                                    <RectangleGeometry Rect="8,8,8,8" />
                                                </GeometryGroup>
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingGroup>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Image x:Name="PreviewImage"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="16" />

                    <!-- 加载中提示 -->
                    <TextBlock x:Name="StatusText"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="White" FontSize="13"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Margin="24" />
                </Grid>
            </Border>

            <!-- 元数据面板 -->
            <Border Grid.Column="1"
                    BorderBrush="#FFE2E6EA" BorderThickness="1,0,0,0"
                    Background="White" Padding="16,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="属性" FontWeight="SemiBold" Margin="0,0,0,10" />

                        <TextBlock Text="名称" Style="{StaticResource HintTextStyle}" />
                        <TextBlock x:Name="NameText" FontFamily="Consolas" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,2,0,8" />

                        <TextBlock Text="路径" Style="{StaticResource HintTextStyle}" />
                        <TextBlock x:Name="PathText" FontFamily="Consolas" FontSize="10"
                                   TextWrapping="Wrap" Margin="0,2,0,8" />

                        <TextBlock Text="尺寸" Style="{StaticResource HintTextStyle}" />
                        <TextBlock x:Name="SizeText" FontFamily="Consolas" FontSize="11" Margin="0,2,0,8" />

                        <TextBlock Text="格式" Style="{StaticResource HintTextStyle}" />
                        <TextBlock x:Name="FormatText" FontFamily="Consolas" FontSize="11" Margin="0,2,0,8" />

                        <TextBlock Text="Mips" Style="{StaticResource HintTextStyle}" />
                        <TextBlock x:Name="MipsText" FontFamily="Consolas" FontSize="11" Margin="0,2,0,8" />

                        <TextBlock Text="LOD Group" Style="{StaticResource HintTextStyle}" />
                        <TextBlock x:Name="LodGroupText" FontFamily="Consolas" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,2,0,8" />

                        <TextBlock Text="LOD Bias" Style="{StaticResource HintTextStyle}" />
                        <TextBlock x:Name="LodBiasText" FontFamily="Consolas" FontSize="11" Margin="0,2,0,8" />

                        <TextBlock Text="Est. 大小" Style="{StaticResource HintTextStyle}" />
                        <TextBlock x:Name="SizeMbText" FontFamily="Consolas" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Background="White" BorderBrush="#FFE2E6EA" BorderThickness="0,1,0,0" Padding="16,6">
            <TextBlock x:Name="FooterText" Style="{StaticResource HintTextStyle}" />
        </Border>
    </Grid>
</Window>
