<UserControl x:Class="UnrealKit.Desktop.Views.LaunchParametersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="启动参数预设" Style="{StaticResource SectionTitleTextStyle}" />
        <TextBlock Grid.Column="1" Text="uecommandline.txt 预览" Style="{StaticResource SectionTitleTextStyle}" Margin="20,0,0,0" />
        <!-- 用 Grid 而非 StackPanel 承载左列：StackPanel 给子元素无限高度，
             ListBox 会长到内容全高，自带的滚动条永远不触发，预设一多就被裁掉。
             这里让列表占据 * 行，高度受页面约束，滚动条才会按需出现。 -->
        <Grid Grid.Row="1" Margin="0,12,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="120" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="选择预设。互斥组内最多选一个；无效组合会在预览中显示原因。" Style="{StaticResource HintTextStyle}" Margin="0,0,0,10" />
            <ListBox Grid.Row="1" ItemsSource="{Binding LaunchParameterPresets}" BorderBrush="#FFE2E6EA" BorderThickness="1"
                     SelectedItem="{Binding SelectedLaunchParameterPreset}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,3,8,0" />
                            <DockPanel Grid.Column="1">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Style="{StaticResource EmphasisTextStyle}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Description}" Style="{StaticResource HintTextStyle}" />
                            </DockPanel>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GroupLabel}" Style="{StaticResource HintTextStyle}" Margin="0,2,0,0" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="2" Text="{Binding SelectedLaunchParameterPresetArguments}" Style="{StaticResource HintTextStyle}" FontFamily="Consolas" Margin="0,6,0,4" />
            <TextBlock Grid.Row="3" Text="自定义参数" Style="{StaticResource StackedFieldLabelTextStyle}" />
            <TextBox Grid.Row="4" Text="{Binding CustomLaunchArguments, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="64" Padding="8,6" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
        </Grid>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LaunchParameterPreview, Mode=OneWay}" IsReadOnly="True" Margin="8,12,0,0" Padding="8" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,18,0,0">
            <Button Content="推送到已选设备" Command="{Binding PushLaunchParametersCommand}" Padding="14,7" Margin="0,0,10,0" />
            <Button Content="删除设备参数" Command="{Binding DeleteLaunchParametersCommand}" Padding="14,7" Margin="0,0,10,0" />
            <Button Content="读取设备参数" Command="{Binding ReadLaunchParametersCommand}" Padding="14,7" Margin="0,0,10,0" />
            <Button Content="启动应用" Command="{Binding StartApplicationCommand}" Padding="14,7" />
        </StackPanel>
        <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="操作目标（推送、启动、删除前请核对）" Style="{StaticResource EmphasisTextStyle}" />
                <TextBox Text="{Binding LaunchOperationSummary, Mode=OneWay}" IsReadOnly="True" Margin="0,6,8,0" Padding="8" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="后台进度" Style="{StaticResource EmphasisTextStyle}" />
                <TextBlock Text="{Binding OperationStage}" Style="{StaticResource HintTextStyle}" Margin="0,4,0,0" />
                <!-- 完整日志见品牌栏的「操作日志」窗口，此处只显示当前阶段。 -->
                <TextBlock Text="完整 ADB 与操作日志请打开右上角「操作日志」。" Style="{StaticResource HintTextStyle}" Margin="0,8,0,0" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="4" Grid.ColumnSpan="2" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="设备已有内容（点击「读取设备参数」从已选设备拉取 uecommandline.txt 原文）" Style="{StaticResource EmphasisTextStyle}" />
            <TextBox Grid.Row="1" Text="{Binding DeviceLaunchParameterContent, Mode=OneWay}" IsReadOnly="True" Margin="0,6,0,0" Padding="8" MinHeight="72" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
        </Grid>
    </Grid>
</UserControl>
