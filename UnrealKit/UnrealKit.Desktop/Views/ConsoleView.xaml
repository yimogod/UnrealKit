<UserControl x:Class="UnrealKit.Desktop.Views.ConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="快速指令" Style="{StaticResource SectionTitleTextStyle}" />
        <StackPanel Grid.Row="1" Margin="0,8,0,12">
            <TextBlock Text="向已选设备的 UE 应用发送单条控制台指令。" Style="{StaticResource HintTextStyle}" />
            <DockPanel Margin="0,10,0,0" LastChildFill="True">
                <Button Content="发送" Command="{Binding SendConsoleCommandCommand}" Padding="14,7" Margin="10,0,0,0" DockPanel.Dock="Right" />
                <TextBox Text="{Binding ConsoleCommandText, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" VerticalContentAlignment="Center" ToolTip="例如: stat fps" />
            </DockPanel>
        </StackPanel>
        <ScrollViewer Grid.Row="2" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" MaxHeight="120">
            <TextBox Text="{Binding ConsoleOutput}" Style="{StaticResource ConsoleEchoTextBoxStyle}" />
        </ScrollViewer>
        <TextBlock Grid.Row="3" Text="指令序列" Style="{StaticResource SectionTitleTextStyle}" Margin="0,16,0,0" />
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="从工程预设中选择序列或直接输入内联指令（格式: cmd1; wait 2000; cmd2）。" Style="{StaticResource HintTextStyle}" />
            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="工程预设序列" Style="{StaticResource FieldLabelTextStyle}" />
                    <ComboBox ItemsSource="{Binding ConsoleSequencePresets}" SelectedValue="{Binding ConsoleSequenceName}" DisplayMemberPath="Name" SelectedValuePath="Name" Padding="8,6" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="内联指令 (cmds)" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox Text="{Binding ConsoleSequenceInlineCmds, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" ToolTip="例如: stat fps; wait 2000; stat unit" />
                </StackPanel>
            </Grid>
            <Button Grid.Row="2" Content="运行序列" Command="{Binding RunConsoleSequenceCommand}" Padding="18,8" HorizontalAlignment="Left" Margin="0,12,0,0" />
            <ScrollViewer Grid.Row="3" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" MinHeight="120">
                <TextBox Text="{Binding ConsoleSequenceOutput}" Style="{StaticResource ConsoleEchoTextBoxStyle}" />
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
