<UserControl x:Class="UnrealKit.Desktop.Views.PakScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:UnrealKit.Desktop.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{Binding SelectedLocalPakPackage.LocalDirectory, StringFormat='包目录：{0}', FallbackValue='未选择 Pak 包。请先在「安装包」页选择一个本地 Pak 包。'}"
                       Style="{StaticResource HintTextStyle}" Margin="0,12,0,0" FontFamily="Consolas" TextWrapping="Wrap" />
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Oodle DLL：" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Grid.Column="1" Text="{Binding PakOodlePath, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Consolas" ToolTip="oo2core_9_win64.dll 路径（可选，用于解压 Oodle 压缩资产）" />
                <TextBlock Grid.Column="3" Text="游戏版本：" VerticalAlignment="Center" Margin="16,0,6,0" />
                <TextBox Grid.Column="4" Text="{Binding PakGameVersion, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Consolas" ToolTip="如 GAME_UE5_6（默认），GAME_UE5_3 等" />
            </Grid>
            <TextBlock Text="{Binding PakScanDescription}" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="扫描" Command="{Binding ScanPakCommand}" Padding="18,8" />
                <Button Content="导出 HTML" Command="{Binding ExportPakScanHtmlCommand}" Padding="14,8" Margin="8,0,0,0" />
                <Button Content="导出 CSV"  Command="{Binding ExportPakScanCsvCommand}"  Padding="14,8" Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TabControl MinHeight="350" Margin="0,12,0,0">
                    <TabItem Header="Textures">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="260" MinWidth="160" MaxWidth="480" />
                            </Grid.ColumnDefinitions>
                            <!-- 左：DataGrid + 分页 -->
                            <DockPanel Grid.Column="0">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="搜索：" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBox Text="{Binding PakTextures.Search, UpdateSourceTrigger=PropertyChanged}"
                                             Width="260" FontFamily="Consolas"
                                             ToolTip="按 Name 或 Path 搜索（区分大小写）" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="◀" Command="{Binding PakTextures.PrevPageCommand}" Padding="8,4" />
                                    <TextBlock Text="{Binding PakTextures.PageInfo}" VerticalAlignment="Center" Margin="8,0" />
                                    <Button Content="▶" Command="{Binding PakTextures.NextPageCommand}" Padding="8,4" />
                                    <TextBlock Text="每页：" VerticalAlignment="Center" Margin="16,0,4,0" />
                                    <ComboBox ItemsSource="{Binding PakPageSizeOptions}" SelectedItem="{Binding PakPageSize}" Width="60" />
                                </StackPanel>
                                <DataGrid ItemsSource="{Binding PakScanTextures}"
                                          SelectedItem="{Binding SelectedPakTexture, Mode=TwoWay}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                          SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name"     Binding="{Binding Name}"            Width="200" />
                                        <DataGridTextColumn Header="Chunk"    Binding="{Binding PakChunkId}"      Width="50" />
                                        <DataGridTextColumn Header="Path"     Binding="{Binding Path}"            Width="650" />
                                        <DataGridTextColumn Header="SizeX"    Binding="{Binding SizeX}"           Width="60" />
                                        <DataGridTextColumn Header="SizeY"    Binding="{Binding SizeY}"           Width="60" />
                                        <DataGridTextColumn Header="Format"   Binding="{Binding Format}"          Width="100" />
                                        <DataGridTextColumn Header="LodBias"  Binding="{Binding LodBias}"         Width="40" />
                                        <DataGridTextColumn Header="LodGroup" Binding="{Binding LodGroup}"        Width="160" />
                                        <DataGridTextColumn Header="Mips"     Binding="{Binding NumMips}"         Width="50" />
                                        <DataGridTextColumn Header="Est. MB"  Binding="{Binding EstimatedSizeMB}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                            <!-- 分隔条 -->
                            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" />
                            <!-- 右：预览面板 -->
                            <Border Grid.Column="2"
                                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                                    BorderThickness="1" Margin="4,0,0,0" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="预览" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <!-- 未选中时的提示 -->
                                    <TextBlock Text="选择一行查看预览。">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource HintTextStyle}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedPakTexture}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- 解码后的图片 -->
                                    <Image MaxWidth="240" MaxHeight="240" Stretch="Uniform"
                                           Source="{Binding SelectedTextureBitmap}">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTextureBitmap}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <!-- 状态/尺寸信息：选中行后显示 -->
                                    <TextBlock Text="{Binding TexturePreviewStatus}"
                                               TextWrapping="Wrap" Margin="0,6,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedPakTexture}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- 选中行的元数据 -->
                                    <StackPanel Margin="0,8,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedPakTexture}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{Binding SelectedPakTexture.Name}"    FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SelectedPakTexture.Format}"  FontFamily="Consolas" FontSize="11" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding SelectedPakTexture.LodGroup}" FontFamily="Consolas" FontSize="11" Margin="0,2,0,0" />
                                        <TextBlock FontFamily="Consolas" FontSize="11" Margin="0,2,0,0">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} × {1}">
                                                    <Binding Path="SelectedPakTexture.SizeX" />
                                                    <Binding Path="SelectedPakTexture.SizeY" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Text="{Binding SelectedPakTexture.NumMips,       StringFormat='Mips: {0}'}"   FontFamily="Consolas" FontSize="11" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding SelectedPakTexture.EstimatedSizeMB, StringFormat='Est. {0} MB'}" FontFamily="Consolas" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <!-- 预览按钮：有 bitmap 后才显示 -->
                                    <Button Content="预览" x:Name="OpenTexturePreviewButton"
                                            Click="OpenTexturePreviewButton_Click"
                                            Padding="14,6" Margin="0,10,0,0" HorizontalAlignment="Left">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTextureBitmap}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem Header="StaticMesh">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="360" MinWidth="200" MaxWidth="600" />
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="搜索：" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBox Text="{Binding PakStaticMeshes.Search, UpdateSourceTrigger=PropertyChanged}"
                                             Width="260" FontFamily="Consolas"
                                             ToolTip="按 Name 或 Path 搜索（区分大小写）" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="◀" Command="{Binding PakStaticMeshes.PrevPageCommand}" Padding="8,4" />
                                    <TextBlock Text="{Binding PakStaticMeshes.PageInfo}" VerticalAlignment="Center" Margin="8,0" />
                                    <Button Content="▶" Command="{Binding PakStaticMeshes.NextPageCommand}" Padding="8,4" />
                                    <TextBlock Text="每页：" VerticalAlignment="Center" Margin="16,0,4,0" />
                                    <ComboBox ItemsSource="{Binding PakPageSizeOptions}" SelectedItem="{Binding PakPageSize}" Width="60" />
                                </StackPanel>
                                <DataGrid ItemsSource="{Binding PakScanStaticMeshes}"
                                          SelectedItem="{Binding SelectedPakStaticMesh, Mode=TwoWay}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                          SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name"          Binding="{Binding Name}"          Width="200" />
                                        <DataGridTextColumn Header="Chunk"         Binding="{Binding PakChunkId}"    Width="50" />
                                        <DataGridTextColumn Header="Path"          Binding="{Binding Path}"          Width="500" />
                                        <DataGridTextColumn Header="LodCount"      Binding="{Binding LodCount}"      Width="70" />
                                        <DataGridTextColumn Header="MaterialCount" Binding="{Binding MaterialCount}" Width="90" />
                                        <DataGridTextColumn Header="Vertices"      Binding="{Binding VertexCount}"   Width="80" />
                                        <DataGridTextColumn Header="Triangles"     Binding="{Binding TriangleCount}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" />
                            <DockPanel Grid.Column="2" Margin="4,0,0,0">
                                <Button Content="预览" x:Name="OpenStaticMeshPreviewButton"
                                        Click="OpenStaticMeshPreviewButton_Click"
                                        DockPanel.Dock="Top" HorizontalAlignment="Left"
                                        Padding="14,6" Margin="0,0,0,4">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedPakStaticMesh}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <views:MeshPreviewControl GlbPath="{Binding MeshPreviewGlbPath}"
                                                          StatusMessage="{Binding MeshPreviewStatus}" />
                            </DockPanel>
                        </Grid>
                    </TabItem>
                    <TabItem Header="SkeletalMesh">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="360" MinWidth="200" MaxWidth="600" />
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="搜索：" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBox Text="{Binding PakSkeletalMeshes.Search, UpdateSourceTrigger=PropertyChanged}"
                                             Width="260" FontFamily="Consolas"
                                             ToolTip="按 Name 或 Path 搜索（区分大小写）" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="◀" Command="{Binding PakSkeletalMeshes.PrevPageCommand}" Padding="8,4" />
                                    <TextBlock Text="{Binding PakSkeletalMeshes.PageInfo}" VerticalAlignment="Center" Margin="8,0" />
                                    <Button Content="▶" Command="{Binding PakSkeletalMeshes.NextPageCommand}" Padding="8,4" />
                                    <TextBlock Text="每页：" VerticalAlignment="Center" Margin="16,0,4,0" />
                                    <ComboBox ItemsSource="{Binding PakPageSizeOptions}" SelectedItem="{Binding PakPageSize}" Width="60" />
                                </StackPanel>
                                <DataGrid ItemsSource="{Binding PakScanSkeletalMeshes}"
                                          SelectedItem="{Binding SelectedPakSkeletalMesh, Mode=TwoWay}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                          SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name"          Binding="{Binding Name}"          Width="200" />
                                        <DataGridTextColumn Header="Chunk"         Binding="{Binding PakChunkId}"    Width="50" />
                                        <DataGridTextColumn Header="Path"          Binding="{Binding Path}"          Width="430" />
                                        <DataGridTextColumn Header="LodCount"      Binding="{Binding LodCount}"      Width="70" />
                                        <DataGridTextColumn Header="MaterialCount" Binding="{Binding MaterialCount}" Width="90" />
                                        <DataGridTextColumn Header="BoneCount"     Binding="{Binding BoneCount}"     Width="80" />
                                        <DataGridTextColumn Header="Vertices"      Binding="{Binding VertexCount}"   Width="80" />
                                        <DataGridTextColumn Header="Triangles"     Binding="{Binding TriangleCount}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" />
                            <DockPanel Grid.Column="2" Margin="4,0,0,0">
                                <Button Content="预览" x:Name="OpenSkeletalMeshPreviewButton"
                                        Click="OpenSkeletalMeshPreviewButton_Click"
                                        DockPanel.Dock="Top" HorizontalAlignment="Left"
                                        Padding="14,6" Margin="0,0,0,4">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedPakSkeletalMesh}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <views:MeshPreviewControl GlbPath="{Binding MeshPreviewGlbPath}"
                                                          StatusMessage="{Binding MeshPreviewStatus}" />
                            </DockPanel>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Diagnostics">
                        <DataGrid ItemsSource="{Binding PakScanDiagnostics}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90" />
                                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="70" />
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
