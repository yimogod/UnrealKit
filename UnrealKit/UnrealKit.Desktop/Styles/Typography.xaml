<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        文本样式全部以 x:Key 显式引用，不使用隐式 TargetType 样式。
        隐式 TextBlock 样式会顺着资源查找链污染 DataGrid 单元格、
        ContentPresenter 承载的按钮文本和 TabItem 标题，理由同 MainWindow.xaml
        中导航样式的说明。

        字号阶梯（自上而下）：
            22  应用标题（品牌栏，仅一处）
            20  页面标题（导航模板注入，仅一处）
            18  页内区块标题
            16  结果摘要
            默认 正文、字段标签、说明文本
    -->

    <!-- 品牌栏应用名 -->
    <Style x:Key="AppTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- 导航模板注入的当前页面标题 -->
    <Style x:Key="PageHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#FF1B263B" />
    </Style>

    <!-- 页面内部区块标题，例如「快速指令」「创建工程」 -->
    <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- 解析/差分/趋势结果区顶部的摘要行，内容来自绑定，长度不可控故允许换行 -->
    <Style x:Key="ResultSummaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 区块标题下方的一段说明文字，与后续表单之间留出间距 -->
    <Style x:Key="SectionDescriptionTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,10,0,16" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 表单字段标签：紧贴其下方的输入控件 -->
    <Style x:Key="FieldLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- 同上，但需要与上一个字段拉开距离（同一竖排表单里的第二项起） -->
    <Style x:Key="StackedFieldLabelTextStyle" TargetType="TextBlock"
           BasedOn="{StaticResource FieldLabelTextStyle}">
        <Setter Property="Margin" Value="0,12,0,6" />
    </Style>

    <!-- 只要加粗、间距由外层容器决定：列表项主字段、分栏小标题 -->
    <Style x:Key="EmphasisTextStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- 次要说明、状态提示：弱化颜色，间距由使用处决定 -->
    <Style x:Key="HintTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#FF52616B" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 左侧导航栏的分组标签「工作流」：弱化颜色 + 加粗 -->
    <Style x:Key="NavigationGroupLabelTextStyle" TargetType="TextBlock"
           BasedOn="{StaticResource HintTextStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!--
        只读等宽输出框（进程 stdout/stderr、归档预览、命令行预览）。
        Foreground 不在此设置：stderr 用红色，由使用处单独覆盖。
    -->
    <Style x:Key="MonospaceOutputTextBoxStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- 同上，但嵌在 ScrollViewer 内、需要浅灰底无边框的控制台回显 -->
    <Style x:Key="ConsoleEchoTextBoxStyle" TargetType="TextBox"
           BasedOn="{StaticResource MonospaceOutputTextBoxStyle}">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="#FFF5F5F5" />
        <Setter Property="Padding" Value="8" />
    </Style>
</ResourceDictionary>
