<Window x:Class="UnrealKit.Desktop.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:UnrealKit.Desktop.Views"
        Title="UnrealKit Setting" Height="700" Width="720" MinHeight="360" MinWidth="520">
    <Grid Background="#FFF7F8FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="White" BorderBrush="#FFE2E6EA" BorderThickness="0,0,0,1" Padding="16,12">
            <TextBlock Text="{Binding ProjectTitle}" Style="{StaticResource SectionTitleTextStyle}" />
        </Border>

        <!-- 配置表单本体复用 SettingsView，未打开工程时保存按钮由 SaveProjectSettingsCommand 自动禁用。 -->
        <Border Grid.Row="1" Margin="16" Background="White" CornerRadius="6"
                BorderBrush="#FFE2E6EA" BorderThickness="1" Padding="20">
            <views:SettingsView />
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#FFE2E6EA" BorderThickness="0,1,0,0" Padding="16,8">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource HintTextStyle}" />
        </Border>
    </Grid>
</Window>
