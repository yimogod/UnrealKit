<Window x:Class="UnrealKit.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UnrealKit" Height="680" Width="1120" MinHeight="520" MinWidth="900">
    <Grid Background="#FFF7F8FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="#FF1B263B" Padding="20,14">
            <DockPanel>
                <TextBlock Text="UnrealKit" Foreground="White" FontSize="22" FontWeight="SemiBold" DockPanel.Dock="Left" />
                <TextBlock Text="当前工程：未打开" Foreground="#FFD8E0EC" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#FFE2E6EA" BorderThickness="0,0,1,0">
                <StackPanel Margin="12">
                    <TextBlock Text="工作流" FontWeight="SemiBold" Foreground="#FF52616B" Margin="8,8,8,12" />
                    <ListBox ItemsSource="{Binding NavigationItems}" SelectedItem="{Binding SelectedNavigationItem}" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" Padding="8" FontSize="14" /></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
            <Grid Grid.Column="1" Margin="28">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="{Binding SelectedNavigationItem}" FontSize="26" FontWeight="SemiBold" Foreground="#FF1B263B" />
                <TextBlock Grid.Row="1" Text="{Binding PageDescription}" Foreground="#FF52616B" Margin="0,8,0,20" TextWrapping="Wrap" />
                <Border Grid.Row="2" Background="White" CornerRadius="6" BorderBrush="#FFE2E6EA" BorderThickness="1" Padding="24">
                    <StackPanel>
                        <TextBlock Text="工程入口" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="创建或打开 .ukit 工程后，按左侧流程执行设备、采集、解析和导出操作。" Margin="0,10,0,20" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="创建工程" Command="{Binding CreateProjectCommand}" Padding="14,7" Margin="0,0,10,0" />
                            <Button Content="打开工程" Command="{Binding OpenProjectCommand}" Padding="14,7" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" Margin="0,20,0,0" Foreground="#FF52616B" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="White" BorderBrush="#FFE2E6EA" BorderThickness="0,1,0,0" Padding="12,8"><TextBlock Text="{Binding StatusMessage}" Foreground="#FF52616B" /></Border>
    </Grid>
</Window>
