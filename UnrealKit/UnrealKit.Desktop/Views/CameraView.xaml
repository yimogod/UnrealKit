<UserControl x:Class="UnrealKit.Desktop.Views.CameraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 地图选择 -->
        <DockPanel Margin="0,0,0,10" LastChildFill="True">
            <TextBlock DockPanel.Dock="Left" Text="地图" VerticalAlignment="Center" Margin="0,0,10,0"
                       Style="{StaticResource SectionTitleTextStyle}" />
            <ComboBox ItemsSource="{Binding CameraMapNames}"
                      SelectedItem="{Binding SelectedCameraMap}"
                      Padding="8,6" MinWidth="200"
                      ToolTip="选择地图后，下方列表显示该地图下配置的全部相机预设" />
        </DockPanel>

        <!-- 预设列表标题 -->
        <DockPanel Grid.Row="1" Margin="0,0,0,6" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="相机预设" VerticalAlignment="Center"
                       Style="{StaticResource SectionTitleTextStyle}" />
            <Button DockPanel.Dock="Right" Content="跳转" Padding="18,6"
                    Command="{Binding JumpToCameraCommand}"
                    ToolTip="将运行中的 UE 相机移到所选预设的位置和旋转" />
        </DockPanel>

        <!-- 预设列表 -->
        <ListBox Grid.Row="2"
                 ItemsSource="{Binding CameraPresets}"
                 SelectedItem="{Binding SelectedCameraPreset}"
                 HorizontalContentAlignment="Stretch"
                 BorderBrush="#FFE2E6EA" BorderThickness="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="8,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Name}" />
                        <TextBlock Grid.Column="1" Text="{Binding PositionSummary}"
                                   VerticalAlignment="Center" Foreground="#FF4B5A70"
                                   FontFamily="Consolas, Courier New, monospace" />
                        <TextBlock Grid.Column="2" Text="{Binding RotationSummary}"
                                   VerticalAlignment="Center" Foreground="#FF4B5A70"
                                   FontFamily="Consolas, Courier New, monospace" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 回显区 -->
        <ScrollViewer Grid.Row="3" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" MaxHeight="90"
                      Visibility="{Binding HasCameraOutput, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBox Text="{Binding CameraOutput}" Style="{StaticResource ConsoleEchoTextBoxStyle}" />
        </ScrollViewer>
    </Grid>
</UserControl>
