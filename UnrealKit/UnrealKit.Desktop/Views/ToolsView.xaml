<UserControl x:Class="UnrealKit.Desktop.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="工具" Style="{StaticResource SectionTitleTextStyle}" />
            <TextBlock Text="设备实用工具集合。" Style="{StaticResource SectionDescriptionTextStyle}" />
            <TextBlock Text="截图" Style="{StaticResource FieldLabelTextStyle}" />
            <TextBlock Text="截取所选设备的屏幕，保存到工程 Saved/Screenshots/&lt;平台&gt;/&lt;时间戳&gt;.png。" Style="{StaticResource HintTextStyle}" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal">
                <Button Content="截图" Command="{Binding TakeScreenshotCommand}" Padding="18,8" />
                <Button Content="打开截图目录" Command="{Binding OpenScreenshotFolderCommand}" Padding="18,8" Margin="12,0,0,0" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
