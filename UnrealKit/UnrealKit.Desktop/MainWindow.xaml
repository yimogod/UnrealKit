<Window x:Class="UnrealKit.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UnrealKit" Height="680" Width="1120" MinHeight="520" MinWidth="900">
    <Grid Background="#FFF7F8FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="#FF1B263B" Padding="20,14">
            <DockPanel>
                <TextBlock Text="UnrealKit" Foreground="White" FontSize="22" FontWeight="SemiBold" DockPanel.Dock="Left" />
                <TextBlock Text="{Binding ProjectTitle}" Foreground="#FFD8E0EC" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#FFE2E6EA" BorderThickness="0,0,1,0">
                <StackPanel Margin="12">
                    <TextBlock Text="工作流" FontWeight="SemiBold" Foreground="#FF52616B" Margin="8,8,8,12" />
                    <ListBox ItemsSource="{Binding NavigationItems}" SelectedItem="{Binding SelectedNavigationItem}" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" Padding="8" FontSize="14" /></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
            <Grid Grid.Column="1" Margin="28">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="{Binding SelectedNavigationItem}" FontSize="26" FontWeight="SemiBold" Foreground="#FF1B263B" />
                <TextBlock Grid.Row="1" Text="{Binding PageDescription}" Foreground="#FF52616B" Margin="0,8,0,20" TextWrapping="Wrap" />
                <Border Grid.Row="2" Background="White" CornerRadius="6" BorderBrush="#FFE2E6EA" BorderThickness="1" Padding="24">
                    <Grid>
                        <StackPanel Margin="0,0,0,28">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedNavigationItem}" Value="工程">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="创建工程" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="创建工程只会生成必要的 .ukit、默认配置和空目录；目标目录非空时会拒绝覆盖。" Margin="0,10,0,16" TextWrapping="Wrap" />
                            <TextBlock Text="工程名称" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBox Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                            <TextBlock Text="工程目录" FontWeight="SemiBold" Margin="0,12,0,6" />
                            <DockPanel LastChildFill="True">
                                <Button Content="浏览…" Click="BrowseNewProjectDirectory_Click" Padding="14,7" Margin="10,0,0,0" DockPanel.Dock="Right" />
                                <TextBox Text="{Binding NewProjectDirectory, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Padding="8,6" />
                            </DockPanel>
                            <Button Content="创建工程" Command="{Binding CreateProjectCommand}" HorizontalAlignment="Left" Padding="18,8" Margin="0,16,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="打开工程" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="选择现有 .ukit 工程描述符。打开时会校验格式版本、目录和默认配置。" Margin="0,10,0,16" TextWrapping="Wrap" />
                            <TextBlock Text="工程文件" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <DockPanel LastChildFill="True">
                                <Button Content="浏览…" Click="BrowseProjectFile_Click" Padding="14,7" Margin="10,0,0,0" DockPanel.Dock="Right" />
                                <TextBox Text="{Binding ProjectFilePath, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Padding="8,6" />
                            </DockPanel>
                            <Button Content="打开工程" Command="{Binding OpenProjectCommand}" HorizontalAlignment="Left" Padding="18,8" Margin="0,16,0,0" />
                        </StackPanel>
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedNavigationItem}" Value="设备">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <Button Content="刷新设备" Command="{Binding RefreshDevicesCommand}" Padding="14,7" DockPanel.Dock="Right" />
                                <TextBlock Text="ADB 设备" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <StackPanel Grid.Row="1" Margin="0,10,0,14">
                                <TextBlock Text="明确选择一台状态为 device 的设备；多设备时不会自动选择第一台。" TextWrapping="Wrap" />
                                <DockPanel Margin="0,12,0,0" LastChildFill="True">
                                    <Button Content="Wi-Fi 连接" Command="{Binding ConnectWirelessDeviceCommand}" Padding="14,7" Margin="10,0,0,0" DockPanel.Dock="Right" />
                                    <TextBox Text="{Binding WirelessEndpoint, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" VerticalContentAlignment="Center" ToolTip="例如：192.168.1.100:5555" />
                                </DockPanel>
                            </StackPanel>
                            <ListBox Grid.Row="2" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" BorderBrush="#FFE2E6EA" BorderThickness="1">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="2*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding SerialNumber}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{Binding Status}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Model}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Grid.Row="3" Text="{Binding SelectedDeviceDescription}" Margin="0,14,0,0" Foreground="#FF52616B" TextWrapping="Wrap" />
                        </Grid>
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedNavigationItem}" Value="启动参数">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="启动参数预设" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="uecommandline.txt 预览" FontSize="18" FontWeight="SemiBold" Margin="20,0,0,0" />
                            <StackPanel Grid.Row="1" Margin="0,12,12,0">
                                <TextBlock Text="选择预设。不可组合的预设只能单独使用；无效组合会在预览中显示原因。" Foreground="#FF52616B" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <ListBox ItemsSource="{Binding LaunchParameterPresets}" BorderBrush="#FFE2E6EA" BorderThickness="1" MinHeight="170">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,3,8,0" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Description}" Foreground="#FF52616B" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Arguments}" FontFamily="Consolas" Foreground="#FF52616B" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="自定义参数" FontWeight="SemiBold" Margin="0,12,0,6" />
                                <TextBox Text="{Binding CustomLaunchArguments, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="64" Padding="8,6" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                                <TextBlock Text="远端 uecommandline.txt 路径" FontWeight="SemiBold" Margin="0,12,0,6" />
                                <TextBox Text="{Binding RemoteCommandLinePath, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                            </StackPanel>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LaunchParameterPreview}" IsReadOnly="True" Margin="8,12,0,0" Padding="8" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,18,0,0">
                                <Button Content="推送到已选设备" Command="{Binding PushLaunchParametersCommand}" Padding="14,7" Margin="0,0,10,0" />
                                <Button Content="删除设备参数" Command="{Binding DeleteLaunchParametersCommand}" Padding="14,7" Margin="0,0,10,0" />
                                <Button Content="启动应用" Command="{Binding StartApplicationCommand}" Padding="14,7" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="White" BorderBrush="#FFE2E6EA" BorderThickness="0,1,0,0" Padding="12,8"><TextBlock Text="{Binding StatusMessage}" Foreground="#FF52616B" /></Border>
    </Grid>
</Window>
