<UserControl x:Class="UnrealKit.Desktop.Views.HistoryTrendView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="历史趋势分析" Style="{StaticResource SectionTitleTextStyle}" />
            <TextBlock Text="基于工程中已归档的采集数据，按时间序列聚合指标变化趋势。需先打开工程。" Style="{StaticResource SectionDescriptionTextStyle}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="数据源" Style="{StaticResource FieldLabelTextStyle}" />
                    <ComboBox ItemsSource="{Binding TrendSourceOptions}" SelectedItem="{Binding TrendSource}" Padding="8,6" />
                    <TextBlock Text="Tag 过滤" Style="{StaticResource StackedFieldLabelTextStyle}" />
                    <TextBox Text="{Binding TrendTag, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="起始日期" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox Text="{Binding TrendFrom, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                    <TextBlock Text="结束日期" Style="{StaticResource StackedFieldLabelTextStyle}" />
                    <TextBox Text="{Binding TrendTo, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                </StackPanel>
            </Grid>
            <TextBlock Text="指标过滤 (逗号分隔, 可选)" Style="{StaticResource StackedFieldLabelTextStyle}" />
            <TextBox Text="{Binding TrendMetricFilter, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
            <Button Content="构建趋势" Command="{Binding RunTrendCommand}" HorizontalAlignment="Left" Padding="18,8" Margin="0,16,0,0" />
        </StackPanel>
        <ScrollViewer Grid.Row="2" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding TrendSummary}" Style="{StaticResource ResultSummaryTextStyle}" />
                <TabControl MinHeight="350" Margin="0,12,0,0">
                    <TabItem Header="Captures">
                        <DataGrid ItemsSource="{Binding TrendCaptures}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding CaptureId}" Width="120" />
                                <DataGridTextColumn Header="Date" Binding="{Binding CaptureDate}" Width="140" />
                                <DataGridTextColumn Header="Platform" Binding="{Binding Platform}" Width="80" />
                                <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="100" />
                                <DataGridTextColumn Header="Device" Binding="{Binding DeviceModel}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Series">
                        <DataGrid ItemsSource="{Binding TrendSeries}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="90" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="130" />
                                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="60" />
                                <DataGridTextColumn Header="Dir" Binding="{Binding Direction}" Width="90" />
                                <DataGridTextColumn Header="Points" Binding="{Binding Points}" Width="55" />
                                <DataGridTextColumn Header="Present" Binding="{Binding Present}" Width="60" />
                                <DataGridTextColumn Header="Missing" Binding="{Binding Missing}" Width="60" />
                                <DataGridTextColumn Header="Min" Binding="{Binding Min}" Width="80" />
                                <DataGridTextColumn Header="Max" Binding="{Binding Max}" Width="80" />
                                <DataGridTextColumn Header="Avg" Binding="{Binding Avg}" Width="80" />
                                <DataGridTextColumn Header="First" Binding="{Binding First}" Width="80" />
                                <DataGridTextColumn Header="Last" Binding="{Binding Last}" Width="80" />
                                <DataGridTextColumn Header="Delta" Binding="{Binding TotalDelta}" Width="80" />
                                <DataGridTextColumn Header="Delta %" Binding="{Binding TotalDeltaPercent}" Width="70" />
                                <DataGridTextColumn Header="Assessment" Binding="{Binding Assessment}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Diagnostics">
                        <DataGrid ItemsSource="{Binding TrendDiagnostics}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90" />
                                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="90" />
                                <DataGridTextColumn Header="Line" Binding="{Binding Line}" Width="70" />
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
