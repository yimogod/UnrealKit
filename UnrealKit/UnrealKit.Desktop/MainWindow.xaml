<Window x:Class="UnrealKit.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:UnrealKit.Desktop.Views"
        xmlns:models="clr-namespace:UnrealKit.Desktop.Models"
        Title="UnrealKit" Height="740" Width="1120" MinHeight="520" MinWidth="900">
    <Window.Resources>
        <!--
            导航样式只以 x:Key 显式引用，不使用隐式 TargetType 样式：
            页面内部（例如 MemInfoParseView）也使用 TabControl 展示数据分页，
            隐式样式会顺着资源查找链污染这些内部分页。
        -->
        <Style x:Key="NavigationTabItemStyle" TargetType="TabItem">
            <Setter Property="Padding" Value="13,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#FF1B263B" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="ItemRoot" Background="Transparent" BorderBrush="Transparent" BorderThickness="3,0,0,0">
                            <ContentPresenter ContentSource="Header"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="#FFF1F4F8" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="#FFEDF1F5" />
                                <Setter TargetName="ItemRoot" Property="BorderBrush" Value="#FF1B263B" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            分组标签样式。GroupStyle 需要 ContainerStyle 显式给出 GroupItem 模板：
            默认模板只渲染子项、不渲染 Name，分组标签不会出现。
        -->
        <GroupStyle x:Key="NavigationGroupStyle">
            <GroupStyle.ContainerStyle>
                <Style TargetType="GroupItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="GroupItem">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               Style="{StaticResource NavigationGroupLabelTextStyle}"
                                               Margin="16,10,8,6" />
                                    <ItemsPresenter />
                                </StackPanel>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </GroupStyle.ContainerStyle>
        </GroupStyle>

        <!--
            页面清单。顺序即导航顺序：分组内按此顺序排列，分组顺序取各组首次出现的顺序。
            每个 View 只实例化一次，切换导航不重建，页面内的输入状态因此得以保留。
        -->
        <x:Array x:Key="NavigationPages" Type="models:NavigationPage">
            <models:NavigationPage Title="工程"       Group="工程"><views:ProjectView /></models:NavigationPage>
            <models:NavigationPage Title="工程配置"   Group="工程"><views:SettingsView /></models:NavigationPage>
            <models:NavigationPage Title="设备"       Group="设备与运行"><views:DevicesView /></models:NavigationPage>
            <models:NavigationPage Title="启动参数"   Group="设备与运行"><views:LaunchParametersView /></models:NavigationPage>
            <models:NavigationPage Title="控制台"     Group="设备与运行"><views:ConsoleView /></models:NavigationPage>
            <models:NavigationPage Title="采集归档"   Group="采集"><views:CaptureView /></models:NavigationPage>
            <models:NavigationPage Title="RenderDoc"  Group="采集"><views:RenderDocView /></models:NavigationPage>
            <models:NavigationPage Title="内存解析"   Group="分析"><views:MemInfoParseView /></models:NavigationPage>
            <models:NavigationPage Title="静态相机"   Group="分析"><views:StaticCameraView /></models:NavigationPage>
            <models:NavigationPage Title="基线差分"   Group="分析"><views:BaselineDiffView /></models:NavigationPage>
            <models:NavigationPage Title="历史趋势"   Group="分析"><views:HistoryTrendView /></models:NavigationPage>
        </x:Array>

        <CollectionViewSource x:Key="NavigationPagesView" Source="{StaticResource NavigationPages}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <!-- 导航项只显示标题；页面内容由模板里的 SelectedItem.View 直接承载。 -->
        <DataTemplate x:Key="NavigationItemTemplate" DataType="{x:Type models:NavigationPage}">
            <TextBlock Text="{Binding Title}" />
        </DataTemplate>

        <Style x:Key="NavigationTabControlStyle" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Background="White" BorderBrush="#FFE2E6EA" BorderThickness="0,0,1,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <!--
                                        必须用 ItemsPresenter，不能用 IsItemsHost="True" 的裸面板：
                                        分组是由 ItemsPresenter 生成 GroupItem 实现的，裸面板会绕过
                                        这一步，导致 GroupStyle 完全不生效（分组标签不渲染）。
                                        面板类型改由下方 ItemsPanel 指定。
                                    -->
                                    <ItemsPresenter Margin="0,6,0,12" />
                                </ScrollViewer>
                            </Border>

                            <Grid Grid.Column="1" Margin="28">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding SelectedNavigationItem}" Style="{StaticResource PageHeaderTextStyle}" />
                                <TextBlock Grid.Row="1" Text="{Binding PageDescription}" Style="{StaticResource HintTextStyle}" Margin="0,8,0,0" />
                                <Border Grid.Row="2" Background="White" CornerRadius="6" BorderBrush="#FFE2E6EA" BorderThickness="1" Padding="20">
                                    <!--
                                        直接取 SelectedItem.View，不用 ContentSource="SelectedContent"：
                                        ItemsSource 承载的是 NavigationPage 而非 TabItem，
                                        TabControl 无法从中推导 SelectedContent（实测恒为 null）。
                                    -->
                                    <ContentPresenter x:Name="PART_SelectedContentHost"
                                                      Content="{Binding SelectedItem.View, RelativeSource={RelativeSource TemplatedParent}}" />
                                </Border>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#FFF7F8FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#FF1B263B" Padding="20,14">
            <DockPanel>
                <TextBlock Text="UnrealKit" Style="{StaticResource AppTitleTextStyle}" DockPanel.Dock="Left" />
                <TextBlock Text="{Binding ProjectTitle}" Foreground="#FFD8E0EC" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!--
            Title 即导航标识：SelectedValuePath="Title" 让 SelectedNavigationItem
            继续作为唯一的当前页面来源，标题、说明文本和 ViewModel 判断都读它。
            新增页面时在 NavigationPages 里追加一项，并同步 ShellViewModel.PageDescription 的分支。
        -->
        <TabControl Grid.Row="1"
                    ItemsSource="{Binding Source={StaticResource NavigationPagesView}}"
                    Style="{StaticResource NavigationTabControlStyle}"
                    ItemContainerStyle="{StaticResource NavigationTabItemStyle}"
                    ItemTemplate="{StaticResource NavigationItemTemplate}"
                    SelectedValuePath="Title"
                    SelectedValue="{Binding SelectedNavigationItem, Mode=TwoWay}">
            <!-- GroupStyle 是只读集合属性，只能追加、不能用特性赋值。 -->
            <TabControl.GroupStyle>
                <StaticResource ResourceKey="NavigationGroupStyle" />
            </TabControl.GroupStyle>
            <!-- 导航项竖排；TabControl 默认横排面板会让分组失去意义。 -->
            <TabControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </TabControl.ItemsPanel>
        </TabControl>

        <Border Grid.Row="2" Background="White" BorderBrush="#FFE2E6EA" BorderThickness="0,1,0,0" Padding="12,8">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource HintTextStyle}" />
        </Border>
    </Grid>
</Window>
