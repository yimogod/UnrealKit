<UserControl x:Class="UnrealKit.Desktop.Views.ConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors">
    <UserControl.Resources>
        <!--
            Bool 列条目：CheckBox，勾选/取消立即发送命令。
            RelativeSource 向上找 ItemsControl（Bool列），再找其 Tag 里存放的 ShellViewModel。
        -->
        <DataTemplate x:Key="BoolItemTemplate">
            <CheckBox Margin="0,2,0,2"
                      IsChecked="{Binding IsChecked}"
                      Content="{Binding Name}"
                      ToolTip="{Binding Description}"
                      VerticalAlignment="Center">
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="Checked">
                        <b:InvokeCommandAction
                            Command="{Binding DataContext.ApplyConsoleCommandPresetCommand,
                                      RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                            CommandParameter="{Binding}" />
                    </b:EventTrigger>
                    <b:EventTrigger EventName="Unchecked">
                        <b:InvokeCommandAction
                            Command="{Binding DataContext.ApplyConsoleCommandPresetCommand,
                                      RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                            CommandParameter="{Binding}" />
                    </b:EventTrigger>
                </b:Interaction.Triggers>
            </CheckBox>
        </DataTemplate>

        <!-- Action 列条目：运行按钮 + 名称 -->
        <DataTemplate x:Key="ActionItemTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,2,0,2"
                        ToolTip="{Binding Description}">
                <Button Content="运行" Padding="10,3"
                        Command="{Binding DataContext.ApplyConsoleCommandPresetCommand,
                                  RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                        CommandParameter="{Binding}" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="14,0,0,0" />
            </StackPanel>
        </DataTemplate>

        <!-- Value 列条目：名称 + 输入框 + 应用按钮 + 当前值 -->
        <DataTemplate x:Key="ValueItemTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,2,0,2"
                        ToolTip="{Binding Description}">
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Width="300" TextTrimming="CharacterEllipsis" />
                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                         Width="60" Padding="5,3" VerticalContentAlignment="Center"
                         ToolTip="要写入的数值" />
                <Button Content="应用" Padding="8,3" Margin="4,0,0,0"
                        Command="{Binding DataContext.ApplyConsoleCommandPresetCommand,
                                  RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                        CommandParameter="{Binding}" />
                <TextBlock Text="{Binding CurrentValueDisplay}" VerticalAlignment="Center"
                           Margin="6,0,0,0" Foreground="#FF4B5A70" MinWidth="50"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding CurrentValueDisplay}"
                           Visibility="{Binding ShowsCurrentValue,
                               Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </DataTemplate>

        <!--
            每个 Group 的模板：三列 Grid，左=开关，中=操作，右=数值。
            每列用 ItemsControl 纵向列出各自子集合。
        -->
        <DataTemplate x:Key="GroupTemplate">
            <StackPanel Margin="0,0,0,8">
                <!-- Group 标题 -->
                <Border Background="#FFF1F4F8" Padding="10,5" Margin="0,0,0,4">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#FF1B263B" />
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 开关列 -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="开关" Foreground="#FF4B5A70" FontSize="11"
                                   Margin="0,0,0,3"
                                   Visibility="{Binding HasBoolItems,
                                       Converter={StaticResource BoolToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{Binding BoolItems}"
                                      ItemTemplate="{StaticResource BoolItemTemplate}" />
                    </StackPanel>

                    <!-- 分隔线 -->
                    <Border Grid.Column="1" Width="1" Background="#FFE2E6EA"
                            VerticalAlignment="Stretch" HorizontalAlignment="Center" />

                    <!-- 操作列 -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="操作" Foreground="#FF4B5A70" FontSize="11"
                                   Margin="0,0,0,3"
                                   Visibility="{Binding HasActionItems,
                                       Converter={StaticResource BoolToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{Binding ActionItems}"
                                      ItemTemplate="{StaticResource ActionItemTemplate}" />
                    </StackPanel>

                    <!-- 分隔线 -->
                    <Border Grid.Column="3" Width="1" Background="#FFE2E6EA"
                            VerticalAlignment="Stretch" HorizontalAlignment="Center" />

                    <!-- 数值列 -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="数值" Foreground="#FF4B5A70" FontSize="11"
                                   Margin="0,0,0,3"
                                   Visibility="{Binding HasValueItems,
                                       Converter={StaticResource BoolToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{Binding ValueItems}"
                                      ItemTemplate="{StaticResource ValueItemTemplate}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,10" LastChildFill="True">
            <TextBlock DockPanel.Dock="Left" Text="快速指令" VerticalAlignment="Center" Margin="0,0,10,0"
                       Style="{StaticResource SectionTitleTextStyle}" />
            <Button Content="发送" Command="{Binding SendConsoleCommandCommand}"
                    Padding="14,7" Margin="10,0,0,0" DockPanel.Dock="Right" />
            <TextBox Text="{Binding ConsoleCommandText, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8,6" VerticalContentAlignment="Center"
                     ToolTip="向已选设备的 UE 应用发送单条控制台指令，例如: stat fps" />
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,6" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="预设指令" VerticalAlignment="Center"
                       Style="{StaticResource SectionTitleTextStyle}" />
            <Button DockPanel.Dock="Right" Content="刷新当前值" Padding="14,6"
                    Command="{Binding RefreshConsoleCommandPresetValuesCommand}"
                    ToolTip="从运行中的 UE 逐项读回开关与数值型预设的当前值；动作型没有当前值" />
        </DockPanel>

        <!--
            DataContext 透传：ItemsControl 的 DataContext 是 ShellViewModel。
            子模板里的 RelativeSource AncestorType=ScrollViewer 向上找到这个 ScrollViewer，
            其 DataContext 就是 ShellViewModel，从而能绑定 ApplyConsoleCommandPresetCommand。
        -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding ConsoleCommandPresetGroups}"
                          ItemTemplate="{StaticResource GroupTemplate}"
                          Margin="4,0" />
        </ScrollViewer>

        <ScrollViewer Grid.Row="3" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" MaxHeight="90"
                      Visibility="{Binding HasConsoleOutput, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBox Text="{Binding ConsoleOutput}" Style="{StaticResource ConsoleEchoTextBoxStyle}" />
        </ScrollViewer>
    </Grid>
</UserControl>
